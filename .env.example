# Any OpenAI-compatible endpoint works. Defaults target OpenRouter.
OPENROUTER_API_KEY=your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Without it, the app uses an in-memory store (zero setup).
# With Postgres (docker compose up -d), lessons persist and resume across restarts.
# DATABASE_URL=postgresql://lesson:lesson@localhost:5432/lesson
